# 通知管道（填哪個就用哪個，可多個）。本機放在 .env；GitHub Actions 放在 repo Settings → Secrets。
NOTIFY_WEBHOOK_URL=            # generic webhook（例如 n8n Webhook 節點的 URL），POST JSON：{text, count, items[]}
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=
LINE_CHANNEL_ACCESS_TOKEN=     # LINE Messaging API（LINE Notify 已於 2025/3 停止服務）
LINE_TO_USER_ID=

# 推送掃描結果到 GitHub（本機／家用主機排程用）：fine-grained PAT，只授權這個 repo 的 Contents: Read and write
GITHUB_TOKEN=
